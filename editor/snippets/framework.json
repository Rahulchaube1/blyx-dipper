      "\\}"
    ]
  },
  "Dipper — di_transition": {
    "prefix": "blyx-dipper-di_transition",
    "body": "di_transition(${1:state}, ${2:token})$0",
    "description": "Walk the portable quote state machine. A valid stream yields [rows, fields]."
